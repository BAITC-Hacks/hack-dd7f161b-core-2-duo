# server-side only, never exposed to the browser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# optional: any OpenAI-compatible endpoint including /v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Session signing: local runs use a constant development default when unset.
# Production MUST set a random secret, identical across all server instances.
# AUTH_SECRET=replace-with-a-random-secret

# Shared passwords for synthetic demo accounts only, not production credentials.
DEMO_EMPLOYEE_PASSWORD=demo
DEMO_HR_PASSWORD=hr-demo
